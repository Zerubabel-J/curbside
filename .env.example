# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Return address — legally required on mailed pieces
CURBSIDE_FROM_NAME=
CURBSIDE_FROM_LINE1=
CURBSIDE_FROM_CITY=
CURBSIDE_FROM_STATE=
CURBSIDE_FROM_ZIP=

# Imagery source: indiana | connecticut | north_carolina
CURBSIDE_SOURCE=indiana

# Spend controls
CURBSIDE_BUDGET=5.00
CURBSIDE_DAILY_MAIL_CAP=50

# Live mail (all four required to actually send)
# LOB_API_KEY=
# CURBSIDE_ALLOW_LIVE_MAIL=1

# States acknowledged after legal review, comma separated
# CURBSIDE_ACK_STATES=
